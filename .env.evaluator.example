# Public streamable-HTTP endpoint of the deployed Portfolio Arena MCP server.
ARENA_MCP_URL=https://arena.example.com/mcp

# Create this in Admin > API Keys. It authenticates Arena MCP calls; it is not
# an OpenAI Platform key.
ARENA_MCP_API_KEY=

# Massive market-data credential exposed only to the read-only model process.
MASSIVE_API_KEY=

# Optional worker tuning.
EVALUATOR_MAX_CONCURRENCY=5
EVALUATOR_POLL_SECONDS=60
EVALUATOR_ATTEMPT_TIMEOUT_SECONDS=1500
EVALUATOR_SERVICE_TIER=fast
